---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import CommandPalette from "../components/command-palette";
import Footer from "../components/footer.astro";
import Navbar from "../components/navbar.astro";
import { site } from "@/content";
import { DEFAULT_THEME, THEME_STORAGE_KEY } from "@/lib/theme-transition";
import "../styles/global.css";
import "@fontsource-variable/fraunces";

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
}

const {
  title = site.defaultSeoTitle,
  description = site.defaultSeoDescription,
  image = site.heroImage,
} = Astro.props;

const optimizedImage = await getImage({ src: image, format: "webp" });
const socialImageURL = new URL(optimizedImage.src, Astro.url).href;
---

<html lang="en" data-route-motion="initial">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />

    <script
      is:inline
      define:vars={{
        defaultTheme: DEFAULT_THEME,
        themeStorageKey: THEME_STORAGE_KEY,
        routeMotionAttribute: "data-route-motion",
      }}
    >
      const isTheme = (value) => value === "dark" || value === "light";
      const getDocumentRoot = (doc = document) => doc.documentElement;
      const setRouteMotion = (state, doc = document) => {
        getDocumentRoot(doc).setAttribute(routeMotionAttribute, state);
      };
      const cancelScheduledRouteMotionSettle = () => {
        if (window.__portfolioRouteMotionFrame === undefined) return;

        cancelAnimationFrame(window.__portfolioRouteMotionFrame);
        window.__portfolioRouteMotionFrame = undefined;
      };
      const scheduleRouteMotionSettle = () => {
        cancelScheduledRouteMotionSettle();

        window.__portfolioRouteMotionFrame = requestAnimationFrame(() => {
          setRouteMotion("settled");
          window.__portfolioRouteMotionFrame = undefined;
        });
      };

      const syncTheme = () => {
        const storedTheme = localStorage.getItem(themeStorageKey);
        const theme = isTheme(storedTheme) ? storedTheme : defaultTheme;
        document.documentElement.classList.toggle("dark", theme === "dark");
      };

      const handleBeforePreparation = () => {
        cancelScheduledRouteMotionSettle();
        setRouteMotion("navigating");
      };

      const handleBeforeSwap = (event) => {
        setRouteMotion("navigating", event.newDocument);
      };

      if (window.__portfolioThemeSyncHandler) {
        document.removeEventListener(
          "astro:after-swap",
          window.__portfolioThemeSyncHandler,
        );
      }

      if (window.__portfolioRouteMotionBeforePreparationHandler) {
        document.removeEventListener(
          "astro:before-preparation",
          window.__portfolioRouteMotionBeforePreparationHandler,
        );
      }

      if (window.__portfolioRouteMotionBeforeSwapHandler) {
        document.removeEventListener(
          "astro:before-swap",
          window.__portfolioRouteMotionBeforeSwapHandler,
        );
      }

      if (window.__portfolioRouteMotionPageLoadHandler) {
        document.removeEventListener(
          "astro:page-load",
          window.__portfolioRouteMotionPageLoadHandler,
        );
      }

      window.__portfolioThemeSyncHandler = syncTheme;
      window.__portfolioRouteMotionBeforePreparationHandler =
        handleBeforePreparation;
      window.__portfolioRouteMotionBeforeSwapHandler = handleBeforeSwap;
      window.__portfolioRouteMotionPageLoadHandler = scheduleRouteMotionSettle;

      document.addEventListener(
        "astro:before-preparation",
        handleBeforePreparation,
      );
      document.addEventListener("astro:before-swap", handleBeforeSwap);
      document.addEventListener("astro:page-load", scheduleRouteMotionSettle);
      document.addEventListener("astro:after-swap", syncTheme);

      syncTheme();
      scheduleRouteMotionSettle();
    </script>

    <Analytics />
  </head>

  <body class="text-foreground bg-background flex flex-col min-h-screen">
    <div transition:persist="site-nav">
      <Navbar />
    </div>
    <div transition:persist="command-palette" style="z-index: 999; position: relative;">
      <CommandPalette client:idle />
    </div>
    <main
      transition:name="page-shell"
      class="mt-20 py-4 w-full max-w-3xl mx-auto px-4 flex-1"
    >
      <slot />
    </main>
    <div class="pt-32"></div>
    <div transition:persist="site-footer">
      <Footer />
    </div>
  </body>
</html>
