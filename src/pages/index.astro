---
import GlobalLayout from "../layouts/global.astro";
import Hero from "../components/hero.astro";
import Stack from "../components/stack.astro";
import Education from "../components/education.astro";
import FeaturedProjects from "../components/featured-projects.astro";
import Experience from "../components/experience.astro";
import ScrollAnimate from "../components/scroll-animate.astro";
---

<GlobalLayout>
  <div class="flex flex-col gap-14">
    <ScrollAnimate stagger={0}>
      <Hero />
    </ScrollAnimate>
    <ScrollAnimate>
      <Experience />
    </ScrollAnimate>
    <ScrollAnimate>
      <FeaturedProjects />
    </ScrollAnimate>
    <ScrollAnimate>
      <Stack />
    </ScrollAnimate>
    <ScrollAnimate>
      <Education />
    </ScrollAnimate>
  </div>
</GlobalLayout>
