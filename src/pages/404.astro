---
import GlobalLayout from "@/layouts/global.astro";
import ScrollAnimate from "@/components/scroll-animate.astro";
---

<GlobalLayout title="Page Not Found | Daniel Xu" description="This page does not exist.">
  <div class="flex flex-col gap-4 py-12">
    <ScrollAnimate stagger={0}>
      <h1 class="text-2xl sm:text-3xl">Page not found</h1>
    </ScrollAnimate>
    <ScrollAnimate stagger={50}>
      <p class="text-sm text-muted-foreground max-w-prose">
        The page you requested does not exist or is no longer available.
      </p>
    </ScrollAnimate>
    <ScrollAnimate stagger={100}>
      <div class="flex items-center gap-4 text-sm">
        <a
          href="/projects"
          class="interactive-link text-muted-foreground hover:text-foreground"
        >
          Back to Projects
        </a>
        <a href="/" class="interactive-link text-muted-foreground hover:text-foreground">
          Go Home
        </a>
      </div>
    </ScrollAnimate>
  </div>
</GlobalLayout>
