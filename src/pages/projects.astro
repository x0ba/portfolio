---
import GlobalLayout from "../layouts/global.astro";
import ProjectTabs from "../components/project-tabs";
import { getProjects, getCategories, urlFor } from "@/lib/sanity";
import { getImage } from "astro:assets";

const projects = await getProjects();
const categories = await getCategories();

// Pre-process images through Astro's image optimization
const projectsWithOptimizedImages = await Promise.all(
  projects.map(async (project) => {
    if (!project.image) {
      return { ...project, optimizedImageUrl: null };
    }
    const sanityUrl = urlFor(project.image).width(1600).height(900).url();
    const optimizedImage = await getImage({
      src: sanityUrl,
      width: 1600,
      height: 900,
    });
    return { ...project, optimizedImageUrl: optimizedImage.src };
  })
);
---

<GlobalLayout>
  <div class="flex flex-col gap-20">
    <h1 class="text-3xl sm:text-5xl font-serif">My Projects</h1>
    <ProjectTabs
      projects={projectsWithOptimizedImages}
      categories={categories}
      client:load
    />
  </div>
</GlobalLayout>
