---
import { getImage } from "astro:assets";
import ProjectTabs from "../components/project-tabs";
import GlobalLayout from "../layouts/global.astro";
import ScrollAnimate from "../components/scroll-animate.astro";
import { categories, projects } from "@/content";

const projectsWithOptimizedImages = await Promise.all(
  projects.map(async (project) => {
    const optimizedImage = await getImage({
      src: project.image,
      width: 1600,
      height: 900,
    });

    return { ...project, optimizedImageUrl: optimizedImage.src };
  }),
);
---

<GlobalLayout>
  <div class="flex flex-col gap-6">
    <ScrollAnimate stagger={0}>
      <h1 class="text-2xl sm:text-3xl">Projects</h1>
    </ScrollAnimate>
    <ScrollAnimate stagger={50}>
      <ProjectTabs
        projects={projectsWithOptimizedImages}
        categories={categories}
        basePath="/projects"
        client:load
      />
    </ScrollAnimate>
  </div>
</GlobalLayout>
