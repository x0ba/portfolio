---
import { getImage } from "astro:assets";
import GlobalLayout from "@/layouts/global.astro";
import ProjectDetailContent from "@/components/project-detail-content";
import {
  getProjectBySlug,
  getProjectSlugs,
  isRouteableProject,
  urlFor,
} from "@/lib/sanity";

export async function getStaticPaths() {
  const slugs = await getProjectSlugs();

  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const slug = Astro.params.slug;

if (!slug) {
  return Astro.redirect("/404");
}

const project = await getProjectBySlug(slug);

if (!project || !isRouteableProject(project)) {
  return Astro.redirect("/404");
}

const optimizedImageUrl = project.image
  ? (
      await getImage({
        src: urlFor(project.image).width(1600).height(900).url(),
        width: 1600,
        height: 900,
      })
    ).src
  : null;

const pageTitle = `${project.name} | Projects | Daniel Xu`;
const pageDescription =
  project.description ??
  `Project details for ${project.name}.`;
---

<GlobalLayout title={pageTitle} description={pageDescription}>
  <div class="flex flex-col gap-6">
    <a
      href="/projects"
      class="text-sm text-muted-foreground hover:text-foreground transition-colors"
    >
      Back to Projects
    </a>

    <div class="rounded-2xl border border-border bg-card overflow-hidden">
      <ProjectDetailContent
        project={{ ...project, optimizedImageUrl }}
        titleAs="h1"
      />
    </div>
  </div>
</GlobalLayout>
