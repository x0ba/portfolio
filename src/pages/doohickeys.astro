---
import { ExternalLink, Github, Wrench } from "@lucide/astro";
import ScrollAnimate from "../components/scroll-animate.astro";
import GlobalLayout from "../layouts/global.astro";
import { doohickeys, site } from "@/content";

const vibeConfig: Record<string, { label: string; bg: string; fg: string }> = {
  "works-probably": {
    label: "works, probably",
    bg: "oklch(0.89 0.15 145)",
    fg: "oklch(0.30 0.10 145)",
  },
  "surprisingly-useful": {
    label: "surprisingly useful",
    bg: "oklch(0.88 0.14 85)",
    fg: "oklch(0.35 0.10 85)",
  },
  "use-at-own-risk": {
    label: "use at own risk",
    bg: "oklch(0.85 0.18 30)",
    fg: "oklch(0.35 0.14 30)",
  },
  "its-a-vibe": {
    label: "it's a vibe",
    bg: "oklch(0.85 0.17 310)",
    fg: "oklch(0.35 0.14 310)",
  },
  "abandoned-but-loved": {
    label: "abandoned but loved",
    bg: "oklch(0.90 0.04 285)",
    fg: "oklch(0.40 0.04 285)",
  },
};

const rotations = [
  "-1.2deg",
  "0.8deg",
  "-0.5deg",
  "1.5deg",
  "-0.9deg",
  "0.3deg",
  "-1.8deg",
  "1.1deg",
  "0.6deg",
  "-0.4deg",
  "1.9deg",
  "-1.4deg",
];

const offsets = [
  "0rem",
  "1.5rem",
  "0.35rem",
  "1.9rem",
  "0.75rem",
  "1.25rem",
  "0.2rem",
  "1.7rem",
  "0.5rem",
  "1.35rem",
  "0.15rem",
  "1.85rem",
];
---

<GlobalLayout
  title={`Doohickeys | ${site.personName}`}
  description="A collection of small, weird, low-stakes things I made."
>
  <div class="flex flex-col gap-8">
    <ScrollAnimate stagger={0}>
      <div class="flex flex-col gap-3">
        <h1 class="font-mono text-2xl sm:text-3xl font-bold tracking-tight">
          doohickeys<span class="motion-glow">_</span>
        </h1>
        <p class="font-mono text-sm text-muted-foreground leading-relaxed max-w-lg">
          Small things I built at weird hours for no particular reason.
          Low-effort, low-stakes, possibly useful. No promises.
        </p>
        <div
          class="border-b border-dashed border-muted-foreground/30 mt-1"
          aria-hidden="true"
        >
        </div>
      </div>
    </ScrollAnimate>

    {
      doohickeys.length > 0 ? (
        <ScrollAnimate stagger={50}>
          <div class="doohickeys-grid">
            {doohickeys.map((doohickey, index) => {
              const rotation = rotations[index % rotations.length];
              const offset = offsets[index % offsets.length];
              const vibe = vibeConfig[doohickey.vibe];

              return (
                <div
                  class="doohickey-grid-item"
                  style={`--card-offset: ${offset};`}
                >
                  <div
                    class="doohickey-card interactive-card group relative border-2 border-dashed border-muted-foreground/20 rounded-sm bg-card p-4 hover:border-muted-foreground/50"
                    style={`--card-rotation: ${rotation};`}
                  >
                    <div class="text-3xl mb-2 transition-transform duration-300 group-hover:scale-110 inline-block">
                      {doohickey.emoji || "~"}
                    </div>

                    <h2 class="font-mono font-bold text-base text-card-foreground">
                      {doohickey.name}
                    </h2>

                    {doohickey.description && (
                      <p class="font-mono text-xs text-muted-foreground mt-1.5 leading-relaxed">
                        {doohickey.description}
                      </p>
                    )}

                    {vibe && (
                      <span
                        class="inline-block font-mono text-[10px] font-semibold tracking-wide uppercase mt-3 px-2 py-0.5 rounded-sm"
                        style={`background: ${vibe.bg}; color: ${vibe.fg};`}
                      >
                        {vibe.label}
                      </span>
                    )}

                    {doohickey.tags.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 mt-2.5">
                        {doohickey.tags.map((tag) => (
                          <span class="font-mono text-[10px] text-muted-foreground bg-secondary px-1.5 py-0.5 rounded-sm">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}

                    {(doohickey.link || doohickey.code) && (
                      <div class="flex items-center gap-3 mt-3 pt-2.5 border-t border-dashed border-muted-foreground/15">
                        {doohickey.link && (
                          <a
                            href={doohickey.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="interactive-link inline-flex items-center gap-1.5 font-mono text-[11px] text-muted-foreground hover:text-foreground"
                          >
                            <ExternalLink class="w-3 h-3" />
                            try it
                          </a>
                        )}
                        {doohickey.code && (
                          <a
                            href={doohickey.code}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="interactive-link inline-flex items-center gap-1.5 font-mono text-[11px] text-muted-foreground hover:text-foreground"
                          >
                            <Github class="w-3 h-3" />
                            source
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </ScrollAnimate>
      ) : (
        <ScrollAnimate stagger={50}>
          <div class="flex flex-col items-center justify-center py-20 gap-4">
            <Wrench
              class="w-10 h-10 text-muted-foreground/40"
              stroke-width={1.5}
            />
            <div class="text-center">
              <p class="font-mono text-sm text-muted-foreground">
                nothing here yet.
              </p>
              <p class="font-mono text-xs text-muted-foreground/60 mt-1">
                check back after the next 2am coding session.
              </p>
            </div>
          </div>
        </ScrollAnimate>
      )
    }
  </div>
</GlobalLayout>

<style>
  .doohickeys-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .doohickey-grid-item {
    width: 100%;
  }

  .doohickey-card {
    transform: rotate(var(--card-rotation, 0deg));
    transform-origin: center top;
  }

  @media (min-width: 640px) {
    .doohickeys-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .doohickey-grid-item {
      margin-top: var(--card-offset, 0rem);
    }
  }
  @media (hover: hover) {
    .doohickey-card:hover {
      transform: translateY(-0.1rem) rotate(0deg);
    }
  }
</style>
