---
import { getExperiences } from "@/lib/sanity";

const experiences = await getExperiences();
---

<div class="flex flex-col gap-3">
  <h2 class="text-xl sm:text-2xl font-serif">Experience</h2>
  <div class="flex flex-col divide-y divide-border">
    {
      experiences.map((exp) => (
        <div class="py-4 first:pt-0 last:pb-0">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
            <h3 class="font-medium text-foreground">{exp.company}</h3>
            <span class="text-xs font-mono text-muted-foreground">
              {exp.startYear} &mdash; {exp.endYear}
            </span>
          </div>
          <p class="text-sm text-muted-foreground mt-0.5">{exp.position}</p>
          {exp.description && (
            <p class="mt-2 text-sm text-muted-foreground/75 leading-relaxed">
              {exp.description}
            </p>
          )}
        </div>
      ))
    }
  </div>
</div>
