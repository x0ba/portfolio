---
import { Image } from "astro:assets";
import { SiGithub } from "react-icons/si";
import { RiExternalLinkFill } from "react-icons/ri";
import type { SanityProject } from "@/lib/sanity";
import { urlFor } from "@/lib/sanity";

interface Props {
  project: SanityProject;
}

const { project } = Astro.props;
const imageUrl = project.image
  ? urlFor(project.image).width(1600).height(900).url()
  : null;
---

<div
  class="group rounded-xl border border-border overflow-hidden bg-card hover:border-foreground/20 transition-all duration-300"
>
  {
    imageUrl && (
      <div class="overflow-hidden">
        <Image
          src={imageUrl}
          alt={project.name}
          width={1600}
          height={900}
          class="w-full aspect-video object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="p-4 flex flex-col gap-2">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-medium">{project.name}</h3>
      {
        (project.link || project.code) && (
          <div class="flex items-center gap-2.5 flex-none">
            {project.link && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted-foreground hover:text-foreground transition-colors"
              >
                <RiExternalLinkFill className="w-4 h-4" />
              </a>
            )}
            {project.code && (
              <a
                href={project.code}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted-foreground hover:text-foreground transition-colors"
              >
                <SiGithub className="w-4 h-4" />
              </a>
            )}
          </div>
        )
      }
    </div>
    <p class="text-sm text-muted-foreground line-clamp-2">
      {project.description}
    </p>
    {
      project.tags && project.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-0.5">
          {project.tags.map((tag) => (
            <span class="text-xs text-muted-foreground bg-secondary px-2 py-0.5 rounded-md">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</div>
