---
import { getImage } from "astro:assets";
import { ArrowRight } from "lucide-react";
import FeaturedProjectsGrid from "@/components/featured-projects-grid";
import { projects } from "@/content";

const featuredProjects = projects.filter((project) => project.featured);

const projectsWithOptimizedImages = await Promise.all(
  featuredProjects.map(async (project) => {
    const optimizedImage = await getImage({
      src: project.image,
      width: 1600,
      height: 900,
    });

    return { ...project, optimizedImageUrl: optimizedImage.src };
  }),
);
---

<div class="flex flex-col gap-4">
  <div class="flex items-center justify-between">
    <h2 class="text-xl sm:text-2xl">Projects</h2>
    <a
      href="/projects"
      class="interactive-link text-muted-foreground flex items-center gap-1 text-sm hover:text-foreground"
    >
      See all
      <ArrowRight width={16} height={16} />
    </a>
  </div>
  <FeaturedProjectsGrid
    projects={projectsWithOptimizedImages}
    basePath="/projects"
    client:load
  />
</div>
