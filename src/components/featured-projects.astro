---
import { getImage } from "astro:assets";
import FeaturedProjectsGrid from "@/components/featured-projects-grid";
import { ArrowRight } from "lucide-react";
import { getFeaturedProjects, urlFor } from "@/lib/sanity";

const projects = await getFeaturedProjects();

const projectsWithOptimizedImages = await Promise.all(
  projects.map(async (project) => {
    if (!project.image) {
      return { ...project, optimizedImageUrl: null };
    }

    const sanityUrl = urlFor(project.image).width(1600).height(900).url();
    const optimizedImage = await getImage({
      src: sanityUrl,
      width: 1600,
      height: 900,
    });

    return { ...project, optimizedImageUrl: optimizedImage.src };
  }),
);
---

<div class="flex flex-col gap-4">
  <div class="flex items-center justify-between">
    <h2 class="text-xl sm:text-2xl font-serif">Projects</h2>
    <a
      href="/projects"
      class="text-muted-foreground flex items-center gap-1 text-sm hover:text-foreground transition-colors"
    >
      See all
      <ArrowRight width={16} height={16} />
    </a>
  </div>
  <FeaturedProjectsGrid
    projects={projectsWithOptimizedImages}
    basePath="/projects"
    client:load
  />
</div>
