---
import { education } from "../data/education";
---

<div class="flex flex-col gap-4">
  <h2 class="font-serif font-semibold text-2xl sm:text-3xl">Education</h2>
  <div class="border border-neutral-800 rounded-3xl p-6 sm:p-10">
    <div class="relative border-l border-neutral-700 space-y-12 pl-8 py-2">
      {
        education.map((edu) => (
          <div class="relative">
            <div class="absolute -left-[44px] top-1 flex h-6 w-6 items-center justify-center rounded-full bg-black border border-neutral-700">
              <div class="h-2 w-2 rounded-full bg-neutral-500" />
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-sm font-mono text-neutral-400">
                {edu.startYear} - {edu.endYear}
              </span>
              <h3 class="text-lg font-semibold text-neutral-100">
                {edu.school}
              </h3>
              <p class="text-base font-medium text-neutral-300">{edu.degree}</p>
              {edu.description && (
                <p class="mt-2 text-sm text-neutral-400 max-w-prose leading-relaxed">
                  {edu.description}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
