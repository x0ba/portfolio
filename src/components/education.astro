---
import { getEducation } from "@/lib/sanity";

const education = await getEducation();
---

<div class="flex flex-col gap-3">
  <h2 class="text-xl sm:text-2xl font-serif">Education</h2>
  <div class="flex flex-col divide-y divide-border">
    {
      education.map((edu) => (
        <div class="py-4 first:pt-0 last:pb-0">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
            <h3 class="font-medium text-foreground">{edu.school}</h3>
            <span class="text-xs font-mono text-muted-foreground">
              {edu.startYear} &mdash; {edu.endYear}
            </span>
          </div>
          <p class="text-sm text-muted-foreground mt-0.5">{edu.degree}</p>
          {edu.description && (
            <p class="mt-2 text-sm text-muted-foreground/75 leading-relaxed">
              {edu.description}
            </p>
          )}
        </div>
      ))
    }
  </div>
</div>
