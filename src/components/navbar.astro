---
import Logo from "@/images/signature.svg";
---

<nav
  class="bg-foreground-primary/90 backdrop-blur-sm h-16 fixed top-0 left-0 right-0 z-50 flex flex-col justify-center"
>
  <div
    class="w-full max-w-3xl mx-auto px-4 flex gap-2 items-center justify-between"
  >
    <div>
      <Logo
        width={56}
        height={56}
        class="filter-[invert(100%)_sepia(0%)_saturate(0%)_hue-rotate(0deg)_brightness(100%)_contrast(100%)] transition-all duration-300 ease-in-out hover:filter-[invert(45%)_sepia(100%)_saturate(2000%)_hue-rotate(310deg)_brightness(90%)_contrast(90%)]"
        onclick="window.location.href='/'"
      />
    </div>
    <div class="flex gap-5 md:gap-10">
      <a
        class="text-gray-400 hover:text-white transition-colors duration-300"
        href="/">Home</a
      >
      <a
        class="text-gray-400 hover:text-white transition-colors duration-300"
        href="/projects">Projects</a
      >
    </div>
  </div>
</nav>
