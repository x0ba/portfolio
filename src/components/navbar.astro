---
import Logo from "@/images/signature.svg";
import { site } from "@/content";
import { ModeToggle } from "./modetoggle";
---

<nav class="fixed top-0 left-0 right-0 z-50 pt-5 pb-4">
  <div class="w-full max-w-3xl mx-auto px-4 flex items-center justify-between">
    <div class="flex items-center md:gap-5 gap-3">
      <a href="/" aria-label="Home" class="interactive-icon-link">
        <Logo
          width={56}
          height={56}
          class="filter-[invert(0%)_sepia(0%)_saturate(0%)_hue-rotate(0deg)_brightness(100%)_contrast(100%)] dark:filter-[invert(100%)_sepia(0%)_saturate(0%)_hue-rotate(0deg)_brightness(100%)_contrast(100%)] transition-all duration-300 ease-in-out hover:filter-[invert(45%)_sepia(100%)_saturate(2000%)_hue-rotate(310deg)_brightness(90%)_contrast(90%)] dark:hover:filter-[invert(45%)_sepia(100%)_saturate(2000%)_hue-rotate(310deg)_brightness(90%)_contrast(90%)]"
        />
      </a>
      {
        site.navLinks.map((link) => (
          <a
            class="interactive-link text-muted-foreground hover:text-foreground"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="flex items-center gap-3 md:gap-5">
      <button
        onclick="document.dispatchEvent(new CustomEvent('open-command-palette'))"
        class="interactive-button hidden sm:flex items-center gap-1.5 text-xs text-muted-foreground border border-border rounded-md px-2 py-1 hover:text-foreground hover:border-foreground/20 cursor-pointer"
        aria-label="Open command palette"
      >
        <kbd class="font-mono text-[10px]">⌘K</kbd>
      </button>
      <ModeToggle client:load />
    </div>
  </div>
</nav>
