---
import { FileUser, Github, Linkedin } from "@lucide/astro";
import { Image } from "astro:assets";
import CopyEmail from "@/components/copy-email";
import { site } from "@/content";

const githubUrl =
  site.socials.find((social) => social.label === "GitHub")?.href || "#";
const linkedinUrl =
  site.socials.find((social) => social.label === "LinkedIn")?.href || "#";
---

<div class="flex flex-col gap-4">
  <div class="flex items-center gap-5">
    <div
      id="hero-avatar"
      class="relative flex-none w-20 h-20 sm:w-24 sm:h-24 rounded-2xl cursor-pointer"
      style="perspective: 800px;"
    >
      <div
        class="hero-avatar-ring absolute -inset-[2px] rounded-2xl opacity-0 transition-opacity duration-300"
      >
      </div>
      <div id="hero-avatar-card" class="hero-avatar-card relative z-[1] w-full h-full">
        <Image
          class="hero-avatar-image rounded-2xl w-full h-full object-cover"
          src={site.heroImage}
          alt={site.personName}
          quality={100}
          loading="eager"
        />
      </div>
    </div>
    <div class="flex flex-col gap-1.5">
      <h1 class="text-3xl sm:text-4xl leading-tight">{site.heroName}</h1>
      <p class="text-sm sm:text-base text-muted-foreground">
        <Fragment set:html={site.heroSubtitle} /> &middot; {site.locationLabel}
      </p>
    </div>
  </div>
  <div class="flex items-center gap-4">
    <a
      href={site.resumePath}
      target="_blank"
      rel="noopener noreferrer"
      class="interactive-link text-sm font-medium text-foreground hover:text-muted-foreground flex items-center gap-1.5"
    >
      <FileUser class="w-4 h-4" />
      Resume
    </a>
    <div class="flex items-center gap-3">
      <a
        href={linkedinUrl}
        aria-label="LinkedIn"
        class="interactive-icon-link text-muted-foreground hover:text-foreground"
        target="_blank"><Linkedin class="w-[18px] h-[18px]" /></a
      >
      <a
        href={githubUrl}
        aria-label="GitHub"
        class="interactive-icon-link text-muted-foreground hover:text-foreground"
        target="_blank"><Github class="w-[18px] h-[18px]" /></a
      >
      <CopyEmail
        email={site.email}
        iconSize={18}
        className="interactive-icon-link text-muted-foreground hover:text-foreground"
        client:load
      />
    </div>
  </div>
</div>

<script>
  import { attachTilt } from "@/lib/tilt";

  declare global {
    interface Window {
      __heroAvatarCleanup?: () => void;
      __heroAvatarPageLoadHandler?: () => void;
    }
  }

  function initHeroAvatar() {
    const el = document.getElementById("hero-avatar");
    if (!el) return () => {};
    const card = el.querySelector<HTMLElement>("#hero-avatar-card");
    if (!card) return () => {};
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    let cleanupTilt = attachTilt(el, 8);

    const ring = el.querySelector<HTMLElement>(".hero-avatar-ring");
    const showRing = () => ring?.classList.replace("opacity-0", "opacity-100");
    const hideRing = () => ring?.classList.replace("opacity-100", "opacity-0");
    el.addEventListener("mouseenter", showRing);
    el.addEventListener("mouseleave", hideRing);

    let flipping = false;
    const handleFlipEnd = (event: AnimationEvent) => {
      if (event.target !== card || event.animationName !== "hero-avatar-flip") {
        return;
      }

      card.classList.remove("hero-avatar-card--flipping");
      cleanupTilt = attachTilt(el, 8);
      flipping = false;
    };

    const handleClick = () => {
      if (flipping || prefersReducedMotion.matches) return;

      flipping = true;
      cleanupTilt();
      card.classList.remove("hero-avatar-card--flipping");
      void card.offsetWidth;
      card.classList.add("hero-avatar-card--flipping");
    };

    card.addEventListener("animationend", handleFlipEnd);
    el.addEventListener("click", handleClick);

    return () => {
      cleanupTilt();
      card.removeEventListener("animationend", handleFlipEnd);
      el.removeEventListener("mouseenter", showRing);
      el.removeEventListener("mouseleave", hideRing);
      el.removeEventListener("click", handleClick);
      card.classList.remove("hero-avatar-card--flipping");
    };
  }

  const mountHeroAvatar = () => {
    window.__heroAvatarCleanup?.();
    window.__heroAvatarCleanup = initHeroAvatar();
  };

  if (window.__heroAvatarPageLoadHandler) {
    document.removeEventListener(
      "astro:page-load",
      window.__heroAvatarPageLoadHandler,
    );
  }

  window.__heroAvatarPageLoadHandler = mountHeroAvatar;
  document.addEventListener("astro:page-load", mountHeroAvatar);
  mountHeroAvatar();
</script>
