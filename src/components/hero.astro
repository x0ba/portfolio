---
import { Image } from "astro:assets";
import heroImage from "@/images/hero.jpg";
import { buttonVariants } from "@/components/ui/button";
import { MapPin, FileUser, Linkedin, Github, Mail } from "@lucide/astro";
---

<div class="flex flex-row-reverse flex-wrap gap-10 items-center justify-center">
  <div class="flex-none w-66 rotate-3">
    <Image
      class="rounded-lg"
      src={heroImage}
      alt="Daniel Xu"
      quality={100}
      loading="eager"
    />
  </div>
  <div class="flex flex-col gap-4 flex-1 min-w-75">
    <h1 class="text-3xl sm:text-5xl font-serif">Daniel Xu</h1>
    <div class="flex items-center gap-2 sm:text-lg text-base">
      <MapPin class="w-4 h-4" /> La Jolla, CA
    </div>
    <div class="text-base sm:text-lg text-wrap">
      Full stack software engineer specializing in building scalable web
      applications with Next.js that solve real-world problems
    </div>
    <div class="flex items-center gap-4">
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class={buttonVariants()}
      >
        <div class="flex items-center gap-2">
          View my Resume
          <FileUser class="w-4 h-4" />
        </div>
      </a>
      <a
        href="https://www.linkedin.com/in/daniel-xu-sd"
        aria-label="LinkedIn"
        class="hover:text-foreground transition-colors duration-300 text-muted-foreground"
        target="_blank"><Linkedin class="w-6 h-6" /></a
      >
      <a
        href="https://github.com/x0ba"
        aria-label="GitHub"
        class="hover:text-foreground transition-colors duration-300 text-muted-foreground"
        target="_blank"><Github class="w-6 h-6" /></a
      >
      <a
        href="mailto:hi@danielx.me"
        aria-label="Email"
        class="hover:text-foreground transition-colors duration-300 text-muted-foreground"
        target="_blank"><Mail class="w-6 h-6" /></a
      >
    </div>
  </div>
</div>
