---
import { Github, Linkedin } from "@lucide/astro";
import CopyEmail from "@/components/copy-email";
---

<footer class="w-full max-w-3xl mx-auto px-4 py-8 flex items-center justify-between">
  <span class="text-xs text-muted-foreground"
    >&copy; {new Date().getFullYear()} Daniel Xu. All Rights Reserved. <br /> Made
    With ❤️ in La Jolla, CA.</span
  >
  <div class="flex items-center gap-3">
    <a
      href="https://www.linkedin.com/in/daniel-xu-sd"
      aria-label="LinkedIn"
      class="text-muted-foreground hover:text-foreground transition-colors"
      target="_blank"><Linkedin class="w-4 h-4" /></a
    >
    <a
      href="https://github.com/x0ba"
      aria-label="GitHub"
      class="text-muted-foreground hover:text-foreground transition-colors"
      target="_blank"><Github class="w-4 h-4" /></a
    >
    <CopyEmail
      email="hi@danielx.me"
      iconSize={16}
      className="text-muted-foreground hover:text-foreground transition-colors"
      client:load
    />
  </div>
</footer>
